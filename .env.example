# Copy to .env: Compose and dotnet run read it. The database is only the team's shared Postgres on the VPS;
# get its user and password from the team. Replace the demo passwords and the JWT key below.
ConnectionStrings__Postgres=Host=192.144.15.126;Port=55432;Database=default
POSTGRES_USER=
POSTGRES_PASSWORD=
Jwt__Key=local_demo_jwt_key_replace_with_random_32_chars
# Service key for the HR integration API (X-Api-Key header, see docs/api.md). Replace it outside the demo.
INTEGRATION_API_KEY=local_demo_integration_key

# Compose seeds three demo accounts. «Войти как…» logs into them without a password
# (POST /api/auth/demo-login); these passwords are only used to create the accounts.
DEMO_ACCOUNTS_SEED=true
DEMO_CONDUCTOR_STAR_PASSWORD=local_demo_star_password
DEMO_CONDUCTOR_NOVICE_PASSWORD=local_demo_novice_password
DEMO_MANAGER_METHODOLOGIST_PASSWORD=local_demo_manager_password

# Optional voice providers. Add real tokens to your private .env.
POLZA_API_KEY=
LAYA_API_TOKEN=
