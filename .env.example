# Local demo values only. Copy to .env and replace every password and the JWT key
# before using this stack outside your own machine.
POSTGRES_USER=turbosquad
POSTGRES_PASSWORD=local_demo_postgres_password
Jwt__Key=local_demo_jwt_key_replace_with_random_32_chars

# Compose seeds the three API accounts when enabled. The current frontend demo
# buttons still open static role screens; they do not authenticate with the API.
DEMO_ACCOUNTS_SEED=true
DEMO_CONDUCTOR_STAR_PASSWORD=local_demo_star_password
DEMO_CONDUCTOR_NOVICE_PASSWORD=local_demo_novice_password
DEMO_MANAGER_METHODOLOGIST_PASSWORD=local_demo_manager_password

# Optional voice providers. Add real tokens to your private .env.
POLZA_API_KEY=
LAYA_API_TOKEN=
